{
  "expo": {
    "name": "PartyUp",
    "slug": "PartyUp",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "partyup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "io.partyup.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:partyup.io",
        "applinks:partyup.io"
      ],
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD74xkP7GBVQtkal7hg8oR8_GtCyGncP20"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#050509"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.partyup.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050509",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C026D3",
          "defaultChannel": "partyup"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PartyUp uses your camera for video Match, livestreaming, and QR scanning.",
          "microphonePermission": "PartyUp uses your microphone for voice during Match and audio during livestreams.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PartyUp uses your photo library to choose photos and videos for profiles, rooms, recaps, and event Memories.",
          "cameraPermission": "PartyUp uses your camera for video Match, livestreaming, and QR scanning.",
          "microphonePermission": "PartyUp uses your microphone for voice during Match and audio during livestreams."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow PartyUp to save room QR posters to your photos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PartyUp uses your location only when you choose Current Location while creating an event."
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1435b43-f548-4c76-a5f7-22c1b4fb661f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e1435b43-f548-4c76-a5f7-22c1b4fb661f"
    }
  }
}
